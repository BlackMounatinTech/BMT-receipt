{
    admin off
    auto_https off
}
:{$PORT} {
    @bookingRoot path /consultation
    redir @bookingRoot /consultation/ 308
    handle_path /consultation/* {
        reverse_proxy 127.0.0.1:8502
    }
    @toolsRoot path /tools
    redir @toolsRoot /tools/ 308
    handle /tools/* {
        reverse_proxy 127.0.0.1:8501
    }
    handle {
        reverse_proxy 127.0.0.1:8503
    }
}
